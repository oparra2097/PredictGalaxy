# Recommended: Travelpayouts (free, instant self-serve signup) for real
# cached flight prices from Aviasales search data. Sign up at
# https://www.travelpayouts.com — the API token is in your profile under
# API Access. Without any provider configured, the app runs entirely on
# realistic mock data.
TRAVELPAYOUTS_TOKEN=
# Optional: your Travelpayouts affiliate marker, appended to booking links
# so click-throughs earn commission.
TRAVELPAYOUTS_MARKER=

# Durable price history (required for tracked routes to persist on
# serverless hosts like Vercel). Create a free Postgres at https://neon.tech
# or https://supabase.com and paste the connection string here — for Neon,
# use the POOLED connection string (the -pooler host). Without this, the
# app falls back to a local SQLite file in the system temp dir: fine for
# `npm run dev`, ephemeral on Vercel.
DATABASE_URL=

# Second price source for seller-spread detection: Google Flights results
# via SerpApi (https://serpapi.com — free tier ~100 searches/month). When
# both this and Travelpayouts are configured, searches compare the two and
# flag big disagreements as consolidator-fare deals.
SERPAPI_KEY=

# Alternative: Amadeus. As of mid-2026 new API access is sales-gated
# (the old free Self-Service tier was retired), so only fill these if you
# already have credentials.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" or "production"
AMADEUS_ENV=test
