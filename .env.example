# Optional: Amadeus Self-Service API (free tier) for real flight offers.
# Sign up at https://developers.amadeus.com/register — the "Flight Offers
# Search" API is free in the test environment (limited quota, test-only data
# pool). Without these set, the app runs entirely on realistic mock data.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# "test" (default, free sandbox) or "production" (paid, real live inventory)
AMADEUS_ENV=test
